# If your local PostgreSQL already holds port 5432, set POSTGRES_PORT before `docker
# compose up` and update the port below to match.
DATABASE_URL=postgresql+psycopg://presser:presser@localhost:5432/presser

# Comma-separated classic league IDs. Never commit real ones.
FPL_LEAGUE_IDS=

# Tweet ingest — optional. Empty TWEET_SOURCE disables it; the worker then runs the FPL
# jobs exactly as before. One of: twscrape, twitterapi_io, x_api.
# Recommended: twscrape — measured p95 detection latency 25.9 s, 0 PLN
# (docs/adr/0005-default-tweet-source-twscrape.md).
TWEET_SOURCE=

# The watched X List's numeric ID (digits only).
X_LIST_ID=

# twscrape (free, cookie-based scraper) — required when TWEET_SOURCE=twscrape.
TWSCRAPE_USERNAME=
TWSCRAPE_COOKIES=
# Where twscrape keeps its account pool (a local SQLite file); defaults to a temp file.
TWSCRAPE_ACCOUNTS_DB=

# twitterapi.io (third-party scraping API) — required when TWEET_SOURCE=twitterapi_io.
TWITTERAPI_IO_KEY=

# Official X API v2 — required when TWEET_SOURCE=x_api.
X_API_BEARER_TOKEN=

# Extraction — optional. Empty OPENROUTER_API_KEY disables it (whatever LLM_MODEL says); the
# worker then runs the FPL jobs and the tweet ingest exactly as before. OpenRouter is the
# only LLM provider.
OPENROUTER_API_KEY=

# The OpenRouter model ID (optional; empty = the default, openai/gpt-6-luna, from ADR 0006).
# A model must have a row in backend/app/extraction/model_settings.toml and backend/app/llm/prices.toml.
LLM_MODEL=

# The OpenRouter model ID answering when the primary fails (optional; empty = the default
# fallback, google/gemini-3.1-flash-lite, from ADR 0006). It must share the primary's
# structured-output method and reasoning effort.
LLM_FALLBACK_MODEL=

# Langfuse Cloud (EU region) tracing — optional; without both keys extraction runs untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com (EU region) when unset.
LANGFUSE_HOST=

# USD → PLN rate used to project the monthly cost in `evaluate`.
USD_PLN_RATE=
