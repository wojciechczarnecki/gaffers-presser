# If your local PostgreSQL already holds port 5432, set POSTGRES_PORT before `docker
# compose up` and update the port below to match.
DATABASE_URL=postgresql+psycopg://presser:presser@localhost:5432/presser

# Comma-separated classic league IDs. Never commit real ones.
FPL_LEAGUE_IDS=

# Tweet ingest — optional. Empty TWEET_SOURCE disables it; the worker then runs the FPL
# jobs exactly as before. One of: twscrape, twitterapi_io, x_api.
# Recommended: twscrape — measured p95 detection latency 25.9 s, 0 PLN
# (docs/adr/0005-default-tweet-source-twscrape.md).
TWEET_SOURCE=

# The watched X List's numeric ID (digits only).
X_LIST_ID=

# twscrape (free, cookie-based scraper) — required when TWEET_SOURCE=twscrape.
TWSCRAPE_USERNAME=
TWSCRAPE_COOKIES=
# Where twscrape keeps its account pool (a local SQLite file); defaults to a temp file.
TWSCRAPE_ACCOUNTS_DB=

# twitterapi.io (third-party scraping API) — required when TWEET_SOURCE=twitterapi_io.
TWITTERAPI_IO_KEY=

# Official X API v2 — required when TWEET_SOURCE=x_api.
X_API_BEARER_TOKEN=

# Extraction — optional. Empty OPENROUTER_API_KEY disables it (whatever LLM_MODEL says); the
# worker then runs the FPL jobs and the tweet ingest exactly as before. OpenRouter is the
# only LLM provider.
OPENROUTER_API_KEY=

# The OpenRouter model ID (optional; empty = the default, openai/gpt-6-luna, from ADR 0006).
# A model must have a row in backend/app/llm/model_settings.toml and backend/app/llm/prices.toml.
LLM_MODEL=

# The OpenRouter model ID answering when the primary fails (optional; empty = the default
# fallback, google/gemini-3.1-flash-lite, from ADR 0006). It must share the primary's
# structured-output method and reasoning effort.
LLM_FALLBACK_MODEL=

# Retrieval indexing runs whenever OPENROUTER_API_KEY is set. The OpenRouter embedding model
# ID (optional; empty = the default, openai/text-embedding-3-small). A model must have an
# input-only (embedding) row in backend/app/llm/prices.toml.
EMBEDDING_MODEL=

# Langfuse Cloud (EU region) tracing — optional; without both keys extraction runs untraced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to https://cloud.langfuse.com (EU region) when unset.
LANGFUSE_HOST=

# USD → PLN rate used to project the monthly cost in `evaluate`.
USD_PLN_RATE=

# Delivery (e-mail via Resend) — optional. Set to `resend` to enable; empty disables it.
DELIVERY_PROVIDER=
RESEND_API_KEY=
# The recipient. Without a verified domain Resend sends only to the Resend account's address.
DELIVERY_EMAIL_TO=
# The sender (optional; empty = onboarding@resend.dev).
DELIVERY_EMAIL_FROM=

# Alerts (e-mail before each deadline) — optional. They run only when delivery, tweet ingest
# and extraction are all enabled; ALERTS_ENABLED=false turns them off explicitly. Empty
# values mean the defaults.
ALERTS_ENABLED=
# Comma-separated slots: the first is the digest, the others are news; breaking e-mails run
# from the last one to the deadline. A slot is either minutes before the deadline (60) or a
# Warsaw wall-clock time n days (1 to 7) before the deadline's date (D-1@20:00). Wall-clock
# slots go from the earliest to the latest; minutes slots are strictly decreasing and come
# after wall-clock ones (default D-1@20:00,60).
ALERT_SLOTS=
# Independent accounts that make a player "trending" (default 3).
ALERT_TRENDING_MIN_ACCOUNTS=
# Overall ownership, in percent, from which a player counts as widely owned (default 15).
ALERT_WIDELY_OWNED_PERCENT=
# The alert window starts at the previous deadline, but never more than this many days before
# the alert deadline, so a long international break does not fill alerts with stale news
# (default 7).
ALERT_MAX_LOOKBACK_DAYS=
# For testing only: a made-up deadline (a Europe/Warsaw time like 2026-10-04T18:00) that runs
# the whole alert cycle with real e-mails, in any environment. Remove it after the test.
ALERT_REHEARSAL_DEADLINE=

# League presser (e-mail after each gameweek) — optional. It runs only when delivery is
# enabled and OPENROUTER_API_KEY is set; PRESSER_ENABLED=false turns it off explicitly.
# Empty values mean the defaults.
# true (default) or false.
PRESSER_ENABLED=
# An OpenRouter model ID with a row in model_settings.toml and prices.toml (default
# openai/gpt-6-luna).
PRESSER_MODEL=
# A JSON object of FPL entry ID to nickname, for example {"123": "Bartas", "456": "Kuba"};
# the nickname replaces the first name from FPL in the presser. Real nicknames never go into
# the repository.
PRESSER_NICKNAMES=
