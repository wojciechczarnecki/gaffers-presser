{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "backend/Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m app.worker run",
    "preDeployCommand": ["alembic upgrade head"],
    "restartPolicyType": "ALWAYS"
  }
}
